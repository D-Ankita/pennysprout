# Copy to .env.local for local development. Never commit real keys.
# Allowed values: local | staging | production
EXPO_PUBLIC_APP_ENV=local
# Local Supabase API URL. On an Android emulator use http://10.0.2.2:54321.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key printed by `supabase status` for the local stack.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
