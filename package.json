{
  "name": "pennysprout",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "export:android": "expo export --platform android --output-dir dist",
    "audit:deps": "npm audit --audit-level=high",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native/metro-config": "0.86.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "test-renderer": "1.2.0"
  }
}
